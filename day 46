Q.Remove all vowels from a string.

#include <stdio.h>
#include <string.h>
int main()
{
    char s[100];
    printf("Enter the string");
    scanf("%s",s);
    for(int i=0;s[i]!='\0';i++)
    {
        if(s[i]=='a'||s[i]=='e'||s[i]=='i'||s[i]=='o'||s[i]=='u'||s[i]=='A'||s[i]=='E'||s[i]=='I'||s[i]=='O'||s[i]=='U')
        for(int j=i;s[j]!='\0';j++)
        s[j]=s[j+1];
    }
    printf("The String without vowels: %s",s);
    return 0;
}
Q. Find the first repeating lowercase alphabet in a string.

#include <stdio.h>
#include <string.h>
int main()
{
    char s[100],ch;
    printf("Enter a string: ");
    scanf("%s",s);
    for(int i=0;s[i]!='\0';i++)
    {
        for(int j=i;s[j]!='\0';j++)
        {
            if(s[j]==s[i] && s[j]>=97 &&s[j]<=120)
            ch=s[j];
        }
    }
    printf("The first repeating lowercase alphabet in the string: %c",ch);
    return 0;
}
