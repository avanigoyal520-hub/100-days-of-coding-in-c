Q. Search for an element in an array using linear search.

#include <stdio.h>
int main()
{
    int n, se, found = 0;
    printf("Enter the size of the array: ");
    scanf("%d", &n);
    int arr[n];
    printf("Enter %d numbers: ", n);
    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);
    printf("Enter the element to search for: ");
    scanf("%d", &se);
    for (int i = 0; i < n; i++)
    {
        if (arr[i] == se)
        {
            found = 1;
            break;
        }
    }
    if (found)
        printf("Element %d is present in the array.\n", se);
    else
        printf("Element %d is not present in the array.\n", se);
    return 0;
}

Q. Reverse an array without taking extra space.

#include <stdio.h>
int main()
{
    int n;
    printf("Enter the size of the array: ");
    scanf("%d", &n);
    int arr[n];
    printf("Enter %d numbers: ", n);
    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);
    for (int i = 0; i < n / 2; i++)
    {
        int temp = arr[i];
        arr[i] = arr[n - i - 1];
        arr[n - i - 1] = temp;
    }
    printf("The reversed array is: ");
    for (int i = 0; i < n; i++)
        printf("%d ", arr[i]);
    printf("\n");
    return 0;
}