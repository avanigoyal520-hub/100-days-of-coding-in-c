Q.Write a program to print the following pattern:
5
45
345
2345
12345
#include <stdio.h>
int main()
{
    int i, j, d;
    for (i = 0; i < 5; i++)
    {
        d = 5 - i; 
        for (j = 0; j <= i; j++)
        {
            printf("%d", d);
            d++;
        }
        printf("\n");
    }
    return 0;
}

Q.Write a program to print the following pattern:
*****
 ****
  ***
   **
    *
#include <stdio.h>
int main()
{
    int i, j;
    for (i = 5; i > 0; i--)
    {
        for (j = 5; j > 0; j--)
        {
            if (j <= i)
                printf("*"); 
            else
                printf(" ");
        }
        printf("\n");
    }
    return 0;
}