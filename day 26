Q.Write a program to print the following pattern:
    5
   45
  345
 2345
12345

#include <stdio.h>
int main()
{
    for(int i=1;i<=5;i++)
    {
        for(int j=1;j<=5;j++)
        {
            if(j>=6-i)
            {
                printf("%d ",j);
            }
            else
            {
                printf("  ");
            }
        }
        printf("\n");
    }
    return 0;
}


Q.Write a program to print the following pattern:

*

*
*
*

*
*
*
*
*

*
*
*

*

#include <stdio.h>
int main() 
{
    for (int i = 1; i <= 5; i++) 
    {
        int diff = i - 3;
        if (diff < 0)
            diff = -diff;
        int count = 5 - 2 * diff;
        for (int j = 0; j < count; j++)
            printf("*\n");
        if (i < 5)
            printf("\n");
    }
    return 0;
}