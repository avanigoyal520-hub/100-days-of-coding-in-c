Q. Write a program to check if a number is a strong number.
#include <stdio.h>
int main()
{
    int n, N, d, fact=1, sumf=0;
    printf("Enter a number: ");
    scanf("%d",&n);
    N=n;
    while(n>0)
        {
            d=n%10;
            fact=1;
            for(int i=1;i<=d;i++)
            {
                fact=fact*i;
            }
            sumf+=fact;
            n/=10;
        }
    if(sumf==N)
    printf("Strong number");
    else
    printf("Not a strong number");
    return 0;
}

Q. Write a program to find the sum of the series: 1 + 3/4 + 5/6 + 7/8 + … up to n terms.
#include <stdio.h>
int main()
{
    int n;
    float sum=1.0;
    printf("Enter the number of terms: ");
    scanf("%d",&n);
    for(int i=1;i<=n;i++)
    {
        sum=sum+(float)((2.0*i+1.0)/(2.0*i+2.0));
    }
    printf("Sum of the series: %.2f", sum);
    return 0;
}
