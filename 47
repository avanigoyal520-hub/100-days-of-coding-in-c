Q. Check if two strings are anagrams of each other.

#include <stdio.h>
#include <string.h>
void main()
{
    char a[100],b[100];
    printf("Enter two words: ");
    scanf("%s %s",a,b);
    if(strlen(a)==strlen(b))
    {
        for(int i=0;a[i]!='\0';i++)
        {
            for(int j=0;b[j]!='\0';j++)
            {
                if(a[i]==b[j])
                continue;
                else
                {
                    break;
                    printf("Not anagram");
                }
            }
        }
        printf("Anagram");
    }
    else
    printf("Not anagram");
}

Q. Find the longest word in a sentence.

#include <stdio.h>
#include <string.h>
void main()
{
    char s[100],ch[100],lon[100]="";
    int j=0,len,lonlen=0;
    printf("Enter a sentence: ");
    fgets(s,100,stdin);
    len=strlen(s);
    s[len]=' ';
    for(int i=0;s[i]!='\0';i++)
    {
        if(s[i]!=' ')
        {
            ch[j]=s[i];
            j++;
        }
        else
        {
            ch[j]='\0';
            len=strlen(ch);
            if(lonlen<len)
            {
                lonlen=len;
                for(int k=0;k<lonlen;k++)
                lon[k]=ch[k];
            }
            j=0;
        }
    }
    printf("Longest word in the sentence: %s",lon);
}