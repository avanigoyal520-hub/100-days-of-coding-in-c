Q. Count frequency of a given character in a string.

#include <stdio.h>
#include <string.h>
int main()
{
    char s[100],ch;
    int cs=0;
    printf("Enter a string: ");
    scanf("%s",s);
    printf("Enter the character whose frequency is to be calculated: ");
    scanf(" %c",&ch);
    for(int i=0;s[i]!='\0';i++)
    {
        if(s[i]==ch)
        cs++;
    }
    printf("Character frequency: %d\n",cs);
    return 0;
}

Q.Toggle case of each character in a string.

#include <stdio.h>
#include <string.h>
int main()
{
    char s[100];
    printf("Enter the string\n");
    scanf("%s",s);
    for(int i=0;s[i]!='\0';i++)
    {
        if(s[i]>=97 && s[i]<=120)
        s[i]=s[i]-32;
        else if(s[i]>=57 && s[i]<=90)
        s[i]=s[i]+32;
    }
    printf("Word after converting cases: %s",s);
    return 0;
}
