Q. Print each character of a string on a new line.


#include <stdio.h>
#include <string.h>
int main()
{
    char s[100];
    printf("Enter the string\n");
    scanf("%s",s);
    printf("The String: ");
    for(int i=0;s[i]!='\0';i++)
    {
        printf("%c",s[i]);
        printf("\n");
    }
    return 0;
}
